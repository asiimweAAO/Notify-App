<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NOTIFY | Student Updates</title>
  <link rel="stylesheet" href="css/style.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <style>
    :root {
      --page: #0d1019;
      --panel: #191d2a;
      --panel2: #10141f;
      --teal: #35b7b5;
      --teal-light: #8bd6d4;
      --text: #f4f6fa;
      --muted: #b8bfce;
      --border: rgba(255,255,255,.10);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0; background: var(--page); color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
    }
    a { text-decoration: none; }
    .notify-nav {
      background: #0d1019; border-bottom: 1px solid var(--border);
      padding: 15px clamp(20px, 6.5vw, 80px);
    }
    .brand { color: var(--teal-light); font-size: 2rem; font-weight: 800; letter-spacing: -.7px; }
    .brand i { color: var(--teal); }
    .nav-links { display: flex; align-items: center; gap: 24px; }
    .nav-links .nav-link { color: #d9deea; font-size: .92rem; padding: 7px 0; transition: color .2s ease; }
    .nav-links .nav-link:hover, .nav-links .nav-link:focus { color: var(--teal-light); }
    .login-button { color: #f7f8fb; border: 1px solid #7b8497; background: transparent; border-radius: 8px; }
    .login-button:hover, .login-button:focus { color: var(--teal-light); border-color: var(--teal); background: rgba(53,183,181,.08); }
    .demo-button { background: var(--teal); color: #071419; border: 1px solid var(--teal); border-radius: 8px; font-weight: 700; }
    .demo-button:hover, .demo-button:focus { background: #8bd6d4; color: #071419; border-color: #8bd6d4; }
    .btn { transition: .25s ease; }
    .hero {
      padding: 70px clamp(20px, 6.5vw, 80px) 62px;
      background: radial-gradient(ellipse at 82% 40%, rgba(45,70,140,.22), transparent 45%),
                  linear-gradient(135deg, #101522, #0d1019);
      border-bottom: 1px solid var(--border);
    }
    .hero h1 { font-size: clamp(2.2rem, 4.3vw, 3.35rem); line-height: 1.12; font-weight: 800; letter-spacing: -1.5px; }
    .hero h1 span { color: var(--teal-light); }
    .hero-copy { color: var(--muted); font-size: 1.08rem; max-width: 550px; line-height: 1.7; }
    .hero-cta { padding: 12px 22px; }
    .stats { display: flex; flex-wrap: wrap; gap: 0; margin-top: 28px; }
    .stat { padding: 0 18px; border-left: 1px solid var(--border); }
    .stat:first-child { padding-left: 0; border-left: 0; }
    .stat strong { display: block; font-size: 1rem; }
    .stat small { color: var(--muted); }
    .dashboard {
      background: rgba(15,18,29,.96); border: 1px solid rgba(255,255,255,.13);
      border-radius: 20px; padding: 20px; box-shadow: 0 24px 60px rgba(0,0,0,.38);
      max-width: 510px; margin: 0 auto; position: relative;
    }
    .dashboard-top { display:flex; justify-content:space-between; align-items:center; gap:12px; margin-bottom:16px; }
    .dashboard-title { font-weight: 700; }
    .healthy { color:#72d6a4; font-size:.75rem; background:rgba(114,214,164,.1); padding:5px 9px; border-radius:20px; }
    .alert-card { display:flex; gap:12px; align-items:flex-start; padding:13px; border-radius:10px; background:var(--panel); border:1px solid rgba(255,255,255,.04); margin-bottom:10px; }
    .alert-badge { font-size:.7rem; font-weight:700; padding:4px 7px; border-radius:5px; white-space:nowrap; }
    .badge-critical { background:#42316b; color:#d8c7ff; }
    .badge-info { background:#243e68; color:#b8d8ff; }
    .badge-new { background:#554426; color:#ffe2a3; }
    .alert-content { flex:1; min-width:0; }
    .alert-content strong { display:block; font-size:.88rem; line-height:1.35; }
    .alert-content small { color:#aab2c3; font-size:.75rem; }
    .delivered { color:#b9c1d0; font-size:.72rem; white-space:nowrap; align-self:center; }
    .chart-box { background:var(--panel2); border:1px solid var(--border); border-radius:10px; padding:12px; margin-top:14px; }
    .chart-label { color:#c5ccda; font-size:.78rem; }
    .chart { height:45px; display:flex; align-items:flex-end; gap:7px; padding-top:8px; }
    .chart span { flex:1; border-radius:4px 4px 0 0; background:linear-gradient(#4ac5c0, #255a76); opacity:.9; }
    .trusted { padding:25px 20px 8px; text-align:center; color:#9ba4b5; font-size:.8rem; letter-spacing:1.5px; }
    .trusted-logos { display:flex; justify-content:center; flex-wrap:wrap; gap:26px; color:#d0d5df; font-weight:700; padding:12px 20px 30px; }
    .section { padding:55px clamp(20px, 6.5vw, 80px); }
    .section-heading { text-align:center; margin-bottom:28px; }
    .section-heading h2 { font-weight:800; font-size:clamp(1.7rem, 3vw, 2.25rem); }
    .section-heading p { color:var(--muted); max-width:650px; margin:10px auto 0; }
    .feature-card { height:100%; padding:25px; background:var(--panel); border:1px solid var(--border); border-radius:15px; transition:transform .25s ease, border-color .25s ease; }
    .feature-card:hover { transform:translateY(-5px); border-color:rgba(53,183,181,.6); }
    .feature-icon { color:var(--teal-light); font-size:1.7rem; margin-bottom:13px; }
    .feature-card h3 { font-size:1.1rem; font-weight:750; }
    .feature-card p { color:var(--muted); line-height:1.65; margin-bottom:0; }
    .how-panel { background:linear-gradient(135deg, #191d2a, #121724); border:1px solid var(--border); border-radius:18px; padding:28px; }
    .step-number { width:38px; height:38px; display:inline-grid; place-items:center; border-radius:50%; background:rgba(53,183,181,.15); color:var(--teal-light); font-weight:800; margin-bottom:12px; }
    .step-card h3 { font-size:1rem; font-weight:700; }
    .step-card p { color:var(--muted); font-size:.92rem; }
    .student-table { background:var(--panel); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
    .student-table .table { color:#e8ebf2; margin:0; }
    .student-table .table th { background:#202637; color:var(--teal-light); }
    .student-table .table td, .student-table .table th { border-color:var(--border); padding:13px; }
    .status-pill { color:#8de0b1; background:rgba(89,203,137,.12); padding:5px 9px; border-radius:20px; font-size:.78rem; }
    .current-note { color:var(--muted); background:rgba(53,183,181,.08); border-left:3px solid var(--teal); padding:15px 18px; border-radius:0 8px 8px 0; }
    footer { border-top:1px solid var(--border); padding:24px clamp(20px, 6.5vw, 80px); color:#9ba4b5; display:flex; flex-wrap:wrap; justify-content:space-between; gap:12px; }
    @media (max-width: 991px) {
      .nav-links { justify-content:center; flex-wrap:wrap; gap:12px 20px; margin-top:14px; }
      .hero { padding-top:48px; }
      .hero-copy { max-width:100%; }
      .dashboard { margin-top:35px; }
    }
    @media (max-width: 575px) {
      .brand { font-size:1.55rem; }
      .nav-actions .btn { padding:7px 10px; font-size:.85rem; }
      .nav-links { gap:8px 15px; }
      .nav-links .nav-link { font-size:.82rem; }
      .hero h1 { letter-spacing:-.8px; }
      .stat { padding:0 10px; margin-bottom:12px; }
      .dashboard { padding:13px; }
      .delivered { display:none; }
      .trusted-logos { gap:15px; }
    }
  </style>
</head>
<body>
  <header class="notify-nav">
    <div class="d-flex justify-content-between align-items-center flex-wrap">
      <a class="brand" href="#" aria-label="Notify home"><i class="bi bi-bell"></i> NOTIFY</a>
      <div class="nav-actions d-flex gap-2">
        <a href="#login" class="btn login-button px-3 py-2">Log In</a>

      </div>
    </div>
    <nav aria-label="Main navigation">
      <ul class="nav-links list-unstyled mb-0">
        <li><a class="nav-link" href="#features">Features</a></li>
        <li><a class="nav-link" href="#solutions">Solutions</a></li>
        <li><a class="nav-link" href="#pricing">See How It works</a></li>
  
        <li><a class="nav-link" href="#security">Security</a></li>
      </ul>
    </nav>
  </header>

  <main>
    <section class="hero text-center">
      <div class="row align-items-center justify-content-center g-5">
        <div class="col-lg-12">
          <p class="text-uppercase fw-bold mb-3" style="color:var(--teal-light);letter-spacing:2px;">Student updates made simple</p>
          <h1>Real-time notifications <span>for students</span></h1>
          <p class="hero-copy mt-3 mx-auto">Stay informed when new coursework, announcements, marks, and learning materials are uploaded to Moodle. NOTIFY brings important updates straight to your phone, so you never miss what matters.</p>
          <div class="d-flex flex-wrap gap-3 mt-4 justify-content-center">
            <a href="#how-it-works" class="btn demo-button hero-cta">See How It Works <i  ms-1"></i></a>
           
          <div class="stats justify-content-center">
            <div class="stat"><strong>Instant alerts</strong><small>New course updates</small></div>
            <div class="stat"><strong>One dashboard</strong><small>Updates in one place</small></div>
            <div class="stat"><strong>Student-first</strong><small>Designed for learning</small></div>
          </div>
        </div>
        <div class="col-12">
         <div class="dashboard mx-auto" aria-label="Illustrative student notifications dashboard">
            <div class="dashboard-top">
              <span class="dashboard-title"><i class="bi bi-bell-fill me-2" style="color:var(--teal);"></i>Notifications Dashboard</span>
              <span class="healthy"><i class="bi bi-circle-fill" style="font-size:7px;"></i> Live preview</span>
            </div>
            <div class="alert-card">
              <span class="alert-badge badge-critical">Important</span>
              <div class="alert-content"><strong>Coursework deadline reminder</strong><small>Human Resource Management · Just now</small></div>
              <span class="delivered"><i class="bi bi-phone"></i> Sent</span>
            </div>
            <div class="alert-card">
              <span class="alert-badge badge-info">New</span>
              <div class="alert-content"><strong>New lecture notes uploaded</strong><small>Business Computing · 5 min ago</small></div>
              <span class="delivered"><i class="bi bi-check2-circle"></i> Delivered</span>
            </div>
            <div class="alert-card">
              <span class="alert-badge badge-new">Update</span>
              <div class="alert-content"><strong>Coursework marks are available</strong><small>Semester 1 · 18 min ago</small></div>
              <span class="delivered"><i class="bi bi-check2-circle"></i> Delivered</span>
            </div>
            <div class="alert-card">
              <span class="alert-badge badge-info">Notice</span>
              <div class="alert-content"><strong>Lecturer posted a new announcement</strong><small>Moodle · 32 min ago</small></div>
              <span class="delivered"><i class="bi bi-check2-circle"></i> Delivered</span>
            </div>
            <div class="chart-box">
              <div class="chart-label">Student updates received (illustrative)</div>
              <div class="chart" aria-hidden="true">
                <span style="height:25%"></span><span style="height:45%"></span><span style="height:35%"></span><span style="height:65%"></span><span style="height:48%"></span><span style="height:78%"></span><span style="height:60%"></span><span style="height:92%"></span><span style="height:72%"></span><span style="height:100%"></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="trusted">
      <div>BUILT WITH STUDENTS IN MIND</div>
    </div>
    <div class="trusted-logos">
      <span><i class="bi bi-mortarboard"></i> Students</span>
      <span><i class="bi bi-journal-text"></i> Moodle Courses</span>
      <span><i class="bi bi-phone"></i> Mobile Alerts</span>
      <span><i class="bi bi-bell"></i> NOTIFY</span>
    </div>

    <section class="section" id="features">
      <div class="section-heading">
        <h2>Important updates, delivered clearly</h2>
        <p>NOTIFY is designed to help students notice new learning information without having to constantly check their Moodle accounts.</p>
      </div>
      <div class="row g-4">
        <div class="col-md-4"><article class="feature-card"><div class="feature-icon"><i class="bi bi-bell"></i></div><h3>Multi-channel notifications</h3><p>Receive alerts about new course materials, announcements, and coursework updates on your phone.</p></article></div>
        <div class="col-md-4" id="security"><article class="feature-card"><div class="feature-icon"><i class="bi bi-shield-check"></i></div><h3>Account-conscious design</h3><p>Student account access and privacy are important considerations as the project’s technical approach is developed.</p></article></div>
        <div class="col-md-4"><article class="feature-card"><div class="feature-icon"><i class="bi bi-speedometer2"></i></div><h3>Stay up to date</h3><p>See examples of new notes, marks, deadlines, and lecturer announcements in one clear notification view.</p></article></div>
      </div>
    </section>

    <section class="section pt-0" id="how-it-works">
      <div class="section-heading">
        <h2>How the programme will work</h2>
        <p>A simple proposed flow for notifying students about Moodle activity.</p>
      </div>
      <div class="how-panel">
        <div class="row g-4">
          <div class="col-md-3"><div class="step-card"><div class="step-number">1</div><h3>Create a NOTIFY account</h3><p>Students sign up or log in to their NOTIFY account.</p></div></div>
          <div class="col-md-3"><div class="step-card"><div class="step-number">2</div><h3>Connect Moodle</h3><p>Students provide the appropriate access through a secure method that the project will define.</p></div></div>
          <div class="col-md-3"><div class="step-card"><div class="step-number">3</div><h3>Check course activity</h3><p>NOTIFY detects whether new content or unread updates are available.</p></div></div>
          <div class="col-md-3"><div class="step-card"><div class="step-number">4</div><h3>Send a phone alert</h3><p>New information is surfaced in the student’s phone notification panel.</p></div></div>
        </div>
      </div>
    </section>

    <section class="section pt-0" id="about">
      <div class="row g-4 align-items-start">
        <div class="col-lg-6">
          <div class="section-heading text-start mb-3"><h2>About the programme</h2></div>
          <p class="text-secondary" style="color:var(--muted)!important;line-height:1.8;">This programme was created to help describe new information uploaded on the UCU Moodle website. Students can miss coursework marks or important academic updates when they do not notice newly uploaded materials. NOTIFY is an idea for bringing updates from Moodle to students’ notification panels, making important course information easier to notice among everyday social media notifications.</p>
        </div>
        <div class="col-lg-6" id="solutions">
          <div class="section-heading text-start mb-3"><h2>Current situation</h2></div>
          <div class="current-note">NOTIFY is currently a project concept. The team is still exploring the best logic and technical approach to make the programme work as expected. Dashboard items and alert examples on this page are illustrative, not live Moodle notifications.</div>
        </div>
      </div>
    </section>

    <section class="section pt-0" id="resources">
      <div class="section-heading"><h2>People under this project</h2><p>Student team details provided for the project.</p></div>
      <div class="student-table table-responsive">
        <table class="table table-hover align-middle">
          <thead><tr><th>Name</th><th>Course</th><th>Year</th><th>Access number</th><th>Team</th></tr></thead>
          <tbody>
            <tr><td>ASIIMWE ATUHUMUZA</td><td>BSCS</td><td>Year 1</td><td>B41203</td><td><span class="status-pill">Member</span></td></tr>
            <tr><td>MUNIALO BRADLEY DAVID</td><td>BSDS</td><td>Year 1</td><td>B39929</td><td><span class="status-pill">Member</span></td></tr>
            <tr><td>BIIRA JOYCE</td><td>BSDS</td><td>Year 1</td><td>B36700</td><td><span class="status-pill">Member</span></td></tr>
            <tr><td>MWOGEZA ELIZABETH</td><td>BSCS</td><td>Year 1</td><td>B39705</td><td><span class="status-pill">Member</span></td></tr>
            <tr><td>ASHANNAH DARLEEN</td><td>BSCS</td><td>Year 1</td><td>B39890</td><td><span class="status-pill">Member</span></td></tr>
            <tr><td>SEAN NELSON SSERUBIRI</td><td>BSCS</td><td>Year 1</td><td>B40457</td><td><span class="status-pill">Member</span></td></tr>
          </tbody>
        </table>
      </div>
    </section>
  </main>

  <footer id="pricing">
    <span><i class="bi bi-bell-fill me-2" style="color:var(--teal);"></i><strong style="color:#e9edf5;">NOTIFY</strong> · Student update concept</span>
    <span>Last modified: Sunday 25th October 2025, 13:44 hours</span>
  </footer>
</body>
</html>
