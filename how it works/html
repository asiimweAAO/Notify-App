      height: 100%;
    }
    .subsection h3 { color: var(--teal-light); margin-bottom: 8px; }
    .subsection p { color: var(--muted); margin: 0; }
    .note {
      padding: 15px 17px;
      color: var(--muted);
      background: rgba(53,183,181,.08);
      border-left: 3px solid var(--teal);
      border-radius: 0 9px 9px 0;
    }
    .example-phone {
      max-width: 700px;
      margin: 20px auto 0;
      padding: 17px;
      border-radius: 19px;
      border: 1px solid rgba(255,255,255,.16);
      background: #090e18;
      box-shadow: 0 18px 45px rgba(0,0,0,.22);
    }
    .phone-heading {
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: #e8edf6;
      margin-bottom: 13px;
    }
    .phone-heading small { color: #9da8bb; }
    .phone-alert {
      display: flex;
      align-items: flex-start;
      gap: 12px;
      padding: 13px;
      margin-top: 9px;
      background: #202637;
      border: 1px solid rgba(255,255,255,.07);
      border-radius: 10px;
    }
    .phone-alert i { color: var(--teal-light); font-size: 1.25rem; }
    .phone-alert strong { display: block; font-size: .92rem; }
    .phone-alert p { color: var(--muted); margin: 2px 0 0; font-size: .85rem; }
    .phone-alert small { display: block; color: #98a4b8; margin-top: 4px; }
    footer {
      border-top: 1px solid var(--line);
      padding: 22px 18px;
      color: #9ba5b7;
      text-align: center;
    }
    @media (max-width: 800px) {
      .flow { grid-template-columns: repeat(2, 1fr); }
      .flow-item:last-child { grid-column: 1 / -1; }
    }
    @media (max-width: 575px) {
      .site-nav { gap: 10px 15px; }
      .hero { padding-top: 48px; }
      .flow { grid-template-columns: 1fr; }
      .flow-item:last-child { grid-column: auto; }
    }
