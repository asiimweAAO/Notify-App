<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>NOTIFY | How the Website Works</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <style>
    :root {
      --background: #0d1019;
      --surface: #191e2b;
      --surface-deep: #111725;
      --teal: #35b7b5;
      --teal-light: #8bd6d4;
      --text: #f3f5fa;
      --muted: #bac2d0;
      --line: rgba(255,255,255,.11);
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--background);
      color: var(--text);
      font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      line-height: 1.7;
    }
    a { color: var(--teal-light); text-decoration: none; }
    a:hover { color: white; }
    .site-header {
      padding: 16px clamp(18px, 6vw, 76px);
      border-bottom: 1px solid var(--line);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      flex-wrap: wrap;
      background: #0d1019;
    }
    .brand {
      color: var(--teal-light);
      font-size: 1.85rem;
      font-weight: 850;
      letter-spacing: -.7px;
      white-space: nowrap;
    }
    .brand i { color: var(--teal); }
    .site-nav { display: flex; gap: 22px; flex-wrap: wrap; }
    .site-nav a { color: #d9deea; font-size: .9rem; }
    .site-nav a:hover, .site-nav a:focus { color: var(--teal-light); }
    .hero {
      text-align: center;
      padding: 68px 20px 58px;
      background:
        radial-gradient(ellipse at 50% 0%, rgba(53,183,181,.13), transparent 55%),
        linear-gradient(135deg, #101522, #0d1019);
      border-bottom: 1px solid var(--line);
    }
    .eyebrow {
      color: var(--teal-light);
      font-size: .82rem;
      font-weight: 800;
      letter-spacing: 2px;
      text-transform: uppercase;
    }
    .hero h1 {
      max-width: 850px;
      margin: 12px auto;
      font-size: clamp(2rem, 4.5vw, 3.25rem);
      line-height: 1.13;
      font-weight: 850;
      letter-spacing: -1.2px;
    }
    .hero h1 span { color: var(--teal-light); }
    .hero p {
      max-width: 780px;
      margin: 16px auto 0;
      color: var(--muted);
      font-size: 1.04rem;
    }
    main { max-width: 1100px; margin: auto; padding: 42px 18px 65px; }
    .section-block { margin-bottom: 27px; }
    .panel {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: 17px;
      padding: clamp(20px, 3vw, 31px);
    }
    .section-heading {
      display: flex;
      align-items: flex-start;
      gap: 13px;
      margin-bottom: 20px;
    }
    .number {
      display: inline-grid;
      place-items: center;
      flex: 0 0 39px;
      height: 39px;
      border-radius: 50%;
      background: rgba(53,183,181,.15);
      color: var(--teal-light);
      font-weight: 850;
    }
    h2 { font-size: 1.42rem; font-weight: 800; margin: 0 0 4px; }
    h3 { font-size: 1.05rem; font-weight: 750; color: #f2f5fb; }
    .section-subtitle { color: var(--muted); margin: 0; }
    .copy { color: var(--muted); margin: 0 0 15px; }
    .copy:last-child { margin-bottom: 0; }
    .info-card {
      height: 100%;
      background: var(--surface-deep);
      border: 1px solid var(--line);
