    }
    .info-card p { color: var(--muted); margin: 0; }
    .homepage-item {
      display: grid;
      grid-template-columns: 42px 1fr;
      gap: 14px;
      padding: 17px 0;
      border-bottom: 1px solid var(--line);
    }
    .homepage-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .homepage-item:first-child { padding-top: 0; }
    .homepage-icon {
      display: grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border-radius: 11px;
      color: var(--teal-light);
      background: rgba(53,183,181,.12);
      font-size: 1.2rem;
    }
    .homepage-item h3 { margin: 0 0 4px; }
    .homepage-item p { color: var(--muted); margin: 0; }
    .flow {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 11px;
      margin: 23px 0;
    }
    .flow-item {
      background: var(--surface-deep);
      border: 1px solid var(--line);
      border-radius: 12px;
      padding: 15px 11px;
