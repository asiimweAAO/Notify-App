    }
    .flow-item i {
      display: block;
      color: var(--teal-light);
      font-size: 1.5rem;
      margin-bottom: 7px;
    }
    .flow-item strong { display: block; font-size: .9rem; line-height: 1.35; }
    .flow-item small { display: block; color: var(--muted); margin-top: 5px; line-height: 1.4; }
    .subsection {
      background: var(--surface-deep);
      border: 1px solid var(--line);
